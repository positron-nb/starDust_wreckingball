%% WB-700 - system block diagram (Phase 1)
%% Logical export generated by build_diagrams.py from the same node/edge data as
%% the presentation SVG/PNG.  Edit build_diagrams.py, not this file.
flowchart LR
  DEV["<b>Development laptop</b><br/>parameters + logs BEFORE the run only;<br/>no link during the run"]
  IMU["<b>IMU 9-DoF</b><br/>stator pitch, roll,<br/>yaw rate"]
  ENC["<b>Encoders</b><br/>2 drive motors<br/>+ shell index"]
  ANG["<b>Steering angle</b><br/>magnetic sensor<br/>on bob pivot"]
  CAM["<b>Camera Module 3</b><br/>Wide, 102 x 67 deg<br/>PRIMARY sensor:<br/>path tracking +<br/>gate identification"]
  VIS["<b>Image processing</b><br/>cone + gate detection<br/>(yellow left / red right)<br/>seam mask, ground<br/>projection"]
  NAV["<b>Autonomous</b><br/>navigation +<br/>course state machine,<br/>sector speed profiles,<br/>pendulum timing"]
  CMD["<b>Motion + steering</b><br/>commands<br/>v_ref, lean_ref,<br/>camera pitch_ref"]
  MCU["<b>Motor-control MCU</b><br/>RP2350 class, 500 Hz:<br/>speed + pendulum damping,<br/>steering angle, camera<br/>stabiliser, cmd time-out"]
  DRV["<b>Motor drivers</b><br/>dual drive 20 A/ch<br/>+ steering driver<br/>(PWM/DIR inputs only)"]
  ACT["<b>Drive actuators</b><br/>2 gearmotors -> ring<br/>gears -> SHELL ROLLS;<br/>worm motor tilts bob;<br/>camera pitch servo"]
  EST["<b>State estimation (EKF)</b><br/>distance, lateral offset,<br/>heading, speed, pitch"]
  BAT["<b>Battery 6S1P Li-ion</b><br/>21.6 V nom., ~97 Wh<br/>BMS: LVC, OC, SC, temp"]
  DISC["<b>MANUAL DISCONNECT</b><br/>arming plug in left<br/>hub (external, flush)"]
  BUS["<b>Main bus</b><br/>40 A fuse at pack,<br/>V / I monitor"]
  REG["<b>Voltage regulation</b><br/>5.1 V / 5 A: Pi 5<br/>3.3-5 V: MCU, sensors,<br/>safety supervisor"]
  KC["<b>Motor-power contactor</b><br/>NO, e-stop channel A;<br/>6 V servo DC-DC after it"]
  TX["<b>Handheld wireless e-stop</b><br/>latching mushroom switch,<br/>2.4 GHz heartbeat 20 Hz"]
  RX["<b>E-stop receiver +</b><br/>safety supervisor (own MCU)<br/>fail-safe: no heartbeat = STOP,<br/>latched until manual re-arm"]
  WD["<b>Hardware watchdog</b><br/>MCU heartbeat<br/>-> WD_OK"]
  BRK["<b>Brake relays (changeover)</b><br/>break-before-make: driver<br/>cut, motor shorted"]
  CAM -->|"CSI-2 50 fps"| VIS
  VIS -->|"cones, gates"| NAV
  NAV --> CMD
  CMD -->|"UART 50 Hz"| MCU
  MCU -->|"PWM / DIR"| DRV
  DRV ==> ACT
  VIS --> EST
  EST --> NAV
  MCU -->|"attitude + odometry 100 Hz"| EST
  IMU -->|"I2C"| MCU
  ENC -->|"quad."| MCU
  ANG -->|"I2C"| MCU
  BAT ==> DISC
  DISC ==> BUS
  BUS ==> REG
  REG -->|"3.3-5 V"| MCU
  BUS ==>|"motor feed"| KC
  KC ==>|"motor bus"| DRV
  TX -.->|"2.4 GHz heartbeat"| RX
  MCU -.->|"heartbeat"| WD
  WD ==>|"WD_OK"| RX
  RX ==>|"contactor coil (A)"| KC
  RX ==>|"brake relays (B)"| BRK
  RX ==>|"PWM gated off (C)"| DRV
  BRK ==>|"motors shorted"| ACT
