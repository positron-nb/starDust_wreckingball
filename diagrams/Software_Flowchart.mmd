%% WB-700 - software flowchart: vision / AI stack and course state machine
%% Logical export generated by build_diagrams.py from the same node/edge data as
%% the presentation SVG/PNG.  Edit build_diagrams.py, not this file.
flowchart LR
  A["<b>Capture</b><br/>Camera Module 3 Wide, 1280 x 720 @ 50 fps"]
  B["<b>Rectify</b><br/>undistort (calibrated through the shell),<br/>apply static seam-band mask"]
  C["<b>Geometry</b><br/>IMU attitude + servo angle -> ground homography"]
  Dk["<b>Colour segmentation</b><br/>red / yellow cones, adaptive HSV<br/>tuned on Sector 1 chevron gates"]
  F["<b>Optional CNN detector</b><br/>YOLO-nano class: cones + pendulum<br/>(CPU, or AI HAT+ if added)"]
  E["<b>Cone map</b><br/>blob filter + ground projection<br/>-> cone positions"]
  G["<b>Track model</b><br/>yellow = left, red = right (RANSAC)<br/>-> lane centre, heading error, gates"]
  H["<b>Pendulum tracker (Sector 4)</b><br/>bob position x(t) in a ROI;<br/>fit period, amplitude, phase"]
  I["<b>EKF fusion</b><br/>vision + IMU + encoders"]
  J["<b>Crossing-window predictor</b><br/>time-to-cross vs. pendulum clearance"]
  K["<b>Controllers + state machine</b><br/>speed profile, lean command, stop / go"]
  S0["<b>SAFE_IDLE</b>"]
  S1["<b>ARMED</b>"]
  S2["<b>CALIBRATE</b>"]
  S3["<b>RUNWAY</b>"]
  S4["<b>RAMP_APPROACH</b>"]
  S5["<b>RAMP_CLIMB</b>"]
  S6["<b>RAMP_EXIT</b>"]
  S12["<b>FINISH</b>"]
  S11["<b>CROSS</b>"]
  S10["<b>COMMIT</b>"]
  S9["<b>OBSERVE</b>"]
  S8["<b>PENDULUM_HOLD</b>"]
  S7["<b>WRECKING_ZONE</b>"]
  SAFE["<b>SAFE_STOP  (from ANY state)</b><br/>watchdog time-out, lane lost > 0.5 s, low battery, excessive tilt -> controlled stop"]
  ESTOP["<b>E-STOP  (hardware, latching)</b><br/>contactor open + changeover brake relays + PWM gated off; overrides software; re-arm only"]
  NOTE["<b>Wrecking zone strategy</b><br/>gyro heading hold + border cones"]
  A --> B
  B --> C
  C --> Dk
  C -.-> F
  Dk --> E
  F -.-> E
  C --> H
  E --> G
  G --> I
  H --> J
  I --> K
  J --> K
  S0 -->|"arming plug in, e-stop RUN, self-test OK"| S1
  S1 -->|"start trigger (method: organisers)"| S2
  S2 -->|"thresholds locked on chevron gates"| S3
  S3 -->|"odometry ~13 m or ramp detected"| S4
  S4 -->|"aligned in gate, speed >= v_ramp"| S5
  S5 -->|"IMU pitch back near level"| S6
  S6 -->|"repeat x 3"| S4
  S6 -->|"3 ramps done (~35 m)"| S7
  S7 -->|"~53 m or pendulum seen"| S8
  S8 -->|"stopped before swing plane"| S9
  S9 -->|"safe window predicted"| S10
  S10 -->|"go"| S11
  S11 -->|"~75 m / finish seen"| S12
  S7 -.-> SAFE
