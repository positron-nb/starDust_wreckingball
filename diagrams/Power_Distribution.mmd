flowchart LR
  CELL["<b>Battery 6S1P Li-ion 21700</b><br/>Molicel P45B cells (datasheet)<br/>21.6 V nom., 18.0-25.2 V<br/>4.5 Ah, ~97 Wh (< 100 Wh)"]
  BMS["<b>6S BMS</b><br/>under-voltage cut-off (LVC),<br/>over-voltage, over-current,<br/>short-circuit, temperature, balance"]
  F1["<b>Main fuse 40 A</b><br/>at the pack terminals"]
  ARM["<b>MANUAL DISCONNECT</b><br/>anti-spark arming plug<br/>(XT90-S class), left polar hub"]
  BUS["<b>Main bus 18-25.2 V</b><br/>INA228-class V/I monitor<br/>software LVC warning to MCU"]
  CHG["<b>Charge port, left hub</b><br/>CC/CV 25.2 V, plug removed"]
  F4["<b>Fuse 5 A</b><br/>logic branch"]
  B5["<b>DC-DC 24 V -> 5.1 V</b><br/>5 A (Pi 5 needs 5 A)"]
  PI["<b>Raspberry Pi 5 + camera</b><br/>~8-12 W (estimate)"]
  MCU["<b>MCU + sensors</b><br/>3.3 V on-board LDO"]
  SUP["<b>Safety supervisor + RX</b><br/>+ watchdog + status LED"]
  NOTE["<b>Logic power notes</b><br/>Pi 5 needs a stable 5.1 V / 5 A rail.<br/>Separate regulated branches<br/>reduce electrical coupling;<br/>logic-rail stability during motor<br/>start, stall and braking needs verification.<br/>Common ground; motor return<br/>kept short and star-pointed."]
  F2["<b>Fuse 30 A</b><br/>actuator branch"]
  K["<b>Contactor, NO</b><br/>e-stop channel A<br/>coil from supervisor"]
  MB["<b>Motor bus</b><br/>TVS + bulk capacitor<br/>(regeneration clamp)"]
  DD["<b>Dual drive driver</b><br/>20 A per channel"]
  BRK["<b>Brake relays (C/O)</b><br/>driver cut, motor shorted"]
  ML["<b>Gearmotor L</b>"]
  MR["<b>Gearmotor R</b>"]
  F3["<b>Fuse 5 A</b>"]
  SD["<b>Steering driver</b>"]
  SM["<b>Steering worm gearmotor</b><br/>self-locking when unpowered"]
  B6["<b>DC-DC 6 V / 3 A</b>"]
  SV["<b>Camera servo</b>"]
